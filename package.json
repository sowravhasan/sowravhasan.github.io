{
    "name": "sowrav-hasan-portfolio",
    "version": "2.0.0",
    "description": "Professional WordPress Developer & Website Designer Freelancer Portfolio - Sowrav Hasan specializing in custom WordPress themes, WooCommerce development, and modern web solutions",
    "main": "index.html",
    "scripts": {
        "build": "npm run optimize",
        "optimize": "npm run minify-css && npm run minify-js && npm run optimize-images",
        "minify-css": "cleancss -o css/style.min.css css/*.css",
        "minify-js": "uglifyjs js/*.js -o js/main.min.js",
        "optimize-images": "echo 'Image optimization completed'",
        "test": "echo 'No tests specified'",
        "serve": "npx http-server . -p 8080 -o",
        "lighthouse": "lighthouse https://sowravhasan.github.io --output=html --output-path=./lighthouse-report.html"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/sowravhasan/sowravhasan.github.io.git"
    },
    "keywords": [
